# Banco de testes isolado (seção 2.3.4): PostgreSQL separado, sem nenhuma credencial de produção.
# No CI é copiado para .env.testing; localmente, copie e ajuste para o seu PostgreSQL de testes.
APP_NAME=lab-dba
APP_ENV=testing
APP_KEY=base64:bGFiLWRiYS1zb21lbnRlLXRlc3Rlcy0tLS0tLS0tLS0=
APP_DEBUG=true

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lab_dba_testing
DB_USERNAME=lab_ci
DB_PASSWORD=lab_ci

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
