APP_NAME=Almoxarifado
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Cuiaba

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Banco criado pelo DBA (scripts/dba/criar-banco.sh). A aplicação usa a conta só de DML;
# as migrations rodam com almox_migrator (pipeline).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=almoxarifado
DB_USERNAME=almox_app
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=almoxarifado_session
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# mostra as contas de demonstração no login (só em ambiente com dados fictícios)
ALMOX_DEMO=false
# volume da massa de produção fictícia (MassaProducaoSeeder)
ALMOX_MOVIMENTACOES=300000
